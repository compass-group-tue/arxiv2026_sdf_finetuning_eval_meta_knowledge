# Hugging Face
HF_TOKEN=your_hf_token_here
HF_USER=your_hf_username_or_org
HF_HOME=/your/path/to/huggingface/home/.cache/huggingface

# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here

# Grader model for agentic_misalignment eval_awareness_scorer (DeliberationClassifier).
# Defaults to anthropic/claude-3-7-sonnet-20250219 if unset.
INSPECT_GRADER_MODEL=

# Optional API keys used by setup.py for warnings/selection
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
GRAYSWAN_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
